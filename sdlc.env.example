# Copy to sdlc.env (git-ignored) and fill in. Never commit or paste real tokens anywhere else.
# Each block is optional: leave it out and that part stays local.
# Verify without creating anything:   sdlc check-integrations

# --- Atlassian Cloud (Jira + Confluence share one API token) ---
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE=https://yourcompany.atlassian.net
ATLASSIAN_EMAIL=you@yourcompany.com
ATLASSIAN_API_TOKEN=
# Use a SANDBOX project/space: runs create real epics, stories and pages.
JIRA_PROJECT=SBX
CONFLUENCE_SPACE=SBX

# --- GitHub ---
# Fine-grained token with access to the owner's repositories:
#   Administration: write (to create repos), Contents: write, Pull requests: write, Metadata: read
# (a classic token with the "repo" scope also works)
GITHUB_TOKEN=
# Your username, or an org you can create repos in. Repos are created private as <prefix><name>.
GITHUB_OWNER=
GITHUB_REPO_PREFIX=sdlc-
